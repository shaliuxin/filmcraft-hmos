# Rust build artifacts
native/rust/target/
**/*.rs.bk

# HarmonyOS build output
**/build/
**/.cxx/
**/.hvigor/
**/oh_modules/
**/node_modules/
*.hap
*.app

# Editor / OS
.idea/
.vscode/
.DS_Store

# Signing material — private keys / keystores. NEVER commit.
# Local backup signing/build-profile.local.json5 stays untracked on purpose.
signing/
**/*.p12
**/*.jks
**/*.p7b
**/*.keystore
**/*.cer
**/*.pem
**/*.der

# DevEco / HarmonyOS local config (per-machine, regenerated by auto-signing)
.ohos/
local.properties

# Local logs / temp / debug scratch
*.log
*.b64
cur_pid.txt
.verify/
.i18n_candidates.txt

# Python cache (scripts/__pycache__)
__pycache__/
*.pyc

# 真机测试原始截图（docs/ 下只保留 README/移植报告引用的精选图）
docs/raw/
